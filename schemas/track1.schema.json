{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVA Hackathon Track 1 row",
  "type": "object",
  "required": [
    "proband_id", "chrom_1", "pos_1", "ref_1", "alt_1", "chrom_2",
    "pos_2", "ref_2", "alt_2", "epcr", "finding_type", "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "proband_id": {"type": "string", "minLength": 1},
    "chrom_1": {"type": "string", "pattern": "^chr([1-9]|1[0-9]|2[0-2]|X|Y|M|MT)$"},
    "pos_1": {"type": "integer", "minimum": 1},
    "ref_1": {"type": "string", "pattern": "^[ACGTN]+$"},
    "alt_1": {"type": "string", "pattern": "^[ACGTN]+$"},
    "chrom_2": {"type": "string"},
    "pos_2": {"type": ["integer", "string"]},
    "ref_2": {"type": "string"},
    "alt_2": {"type": "string"},
    "epcr": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "finding_type": {"enum": ["primary", "secondary"]},
    "notes": {"type": "string"}
  }
}

